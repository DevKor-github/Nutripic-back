// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uid             String            @id @unique @db.VarChar(128)
  storage         Storage[]
  recipeBookmark RecipeBookmark[]

  @@map("user")
}

model Storage {
  user   User         @relation(fields: [userId], references: [uid])
  userId String       @map("user_id")
  type   StorageType
  food   Food[]

  @@id([userId, type])
  @@map("storage")
}

model Food {
  id           Int          @id @default(autoincrement())
  storedIn     Storage      @relation(fields: [userId, storageType], references: [userId, type]) 
  userId       String
  storageType StorageType
  name         String       @db.VarChar(255)
  exists       Boolean      @default(true)
  class1       String       @db.VarChar(255) //대분류
  class2       String       @db.VarChar(255) @default("기타") //중분류
  addedDate    DateTime     @default(now()) @map("added_date")
  expireDate   DateTime?                    @map("expire_date")
  expired      Boolean      @default(false)

  @@map("food")
}

enum StorageType {
  fridge
  freezer
  room

  @@map("storage_type")
}

model Recipe {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(255)
  procedures   String
  difficulty   Int //? enum으로 난이도 구분하기?
  cookingTime Int  @map("cooking_time")//분 단위  

  recipeIngredient RecipeIngredient[]
  recipeBookmark  RecipeBookmark[]

  @@map("recipe")
}

model RecipeIngredient {
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId Int    @map("recipe_id")
  name     String
  amout    Float

  @@id([recipeId, name])
  @@map("recipe_ingredient")
}

model RecipeBookmark {
  user     User   @relation(fields: [userId], references: [uid])
  userId   String @map("user_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId Int    @map("recipe_id")

  @@id([userId, recipeId])
  @@map("recipe_bookmark")
}
