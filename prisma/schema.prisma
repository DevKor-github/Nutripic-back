generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uid             String            @id @unique @db.VarChar(128)
  storage         Storage[]
  recipeBookmark RecipeBookmark[]
  Diary   Diary[]

  @@map("user")
}

model Storage {
  user   User         @relation(fields: [userId], references: [uid])
  userId String       @map("user_id")
  type   StorageType
  food   Food[]

  @@id([userId, type])
  @@map("storage")
}

model Food {
  id           Int          @id @default(autoincrement())
  storedIn     Storage      @relation(fields: [userId, storageType], references: [userId, type]) 
  userId       String       @map("user_id")
  storageType  StorageType  @map("storage_type")
  name         String       @db.VarChar(255)
  class1       String       @db.VarChar(255) //대분류
  class2       String       @db.VarChar(255) @default("기타") //중분류
  icon         String       @db.VarChar(255) @default("null")
  addedDate    DateTime     @default(now()) @map("added_date")
  expireDate   DateTime?                    @map("expire_date")
  expired      Boolean      @default(false)

  @@map("food")
}

model FoodInfo {
  id           Int    @id @default(autoincrement())
  category1    String @db.VarChar(255) //대분류
  category2    String @db.VarChar(255) @default("기타") //중분류
  storageType  StorageType @map("storage_type")
  expireDate   Int?   @map("expire_date") //일 단위

  @@map("food_info")
}

enum StorageType {
  fridge
  freezer
  room

  @@map("storage_type")
}

model Recipe {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(255)
  procedure    String
  difficulty   Int //? enum으로 난이도 구분하기?
  cookingTime  Int  @map("cooking_time")//분 단위
  imageUrl     String @map("image_url") @default("null")

  ingredient IngredientRecipeIndex[]
  recipeBookmark  RecipeBookmark[]

  @@map("recipe")
}

model Ingredient {
  name     String @id @db.VarChar(255)

  recipes  IngredientRecipeIndex[]

  @@map("ingredient")
}

model IngredientRecipeIndex {
  recipeId Int @map("recipe_id")
  recipe Recipe @relation(fields: [recipeId], references: [id])

  ingredientName String @map("ingredient_name")
  ingredient Ingredient @relation(fields:[ingredientName], references: [name])

  amount String @db.VarChar(255)

  ingredientCount Int @map("ingredient_count")

  @@id([ingredientName, recipeId])
  @@map("ingredient_recipe_index")
}

model RecipeBookmark {
  user     User   @relation(fields: [userId], references: [uid])
  userId   String @map("user_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId Int    @map("recipe_id")

  @@id([userId, recipeId])
  @@map("recipe_bookmark")
}

model Diary{
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [uid])
  userId String
  body String
  date DateTime @default(now()) @db.Timestamp
  url String
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamp
  deletedAt DateTime? @db.Timestamp

  @@map("diary")
} // recipe와도 참조관계를 설정하여 어떤 레시피에 따라 요리를 했는지 다이어리에 표시하는 것도 좋을 것 같습니다!

