// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  uid             String            @id @unique @db.VarChar(128)
  storage         storage[]
  recipe_bookmark recipe_bookmark[]
}

model storage {
  user   user         @relation(fields: [userId], references: [uid])
  userId String
  type   storage_type
  food   food[]

  @@id([userId, type])
}

model food {
  id           Int          @id @default(autoincrement())
  storedIn     storage      @relation(fields: [userId, storage_type], references: [userId, type])
  userId       String
  storage_type storage_type
  name         String       @db.VarChar(255)
  amount       Int          @default(1)
  category     String
  addedDate    DateTime     @default(now())
  expireDate   DateTime?
  expired      Boolean      @default(false)
}

enum storage_type {
  fridge
  freezer
  room
}

model recipe {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(255)
  procedures   String
  difficulty   Int //? enum으로 난이도 구분하기?
  cooking_time Int //분 단위 

  recipe_ingredient recipe_ingredient[]
  recipe_bookmark   recipe_bookmark[]
}

model recipe_ingredient {
  recipe   recipe @relation(fields: [recipeId], references: [id])
  recipeId Int
  name     String
  amout    Float

  @@id([recipeId, name])
}

model recipe_bookmark {
  user     user   @relation(fields: [userId], references: [uid])
  userId   String
  recipe   recipe @relation(fields: [recipeId], references: [id])
  recipeId Int

  @@id([userId, recipeId])
}
